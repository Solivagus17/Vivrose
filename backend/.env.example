# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_BUCKET=medical-reports

# Database (Supabase connection string — use the pooler URI)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Firebase Admin SDK service-account JSON path (e.g. ../vivrose-fb.json or relative to backend)
GOOGLE_APPLICATION_CREDENTIALS=../vivrose-fb.json

# Dev only: set to 1 to skip Firebase verification (accepts any bearer token)
FIREBASE_ALLOW_UNVERIFIED=0
