# Copy this file to .env and fill in real values.

# ── Supabase (backend only — Vite ignores these) ────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# ── Flask backend ────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── Firebase (frontend, required) ─────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Hosted backend URL reachable from the browser
VITE_API_URL=https://api.vivrose.health
